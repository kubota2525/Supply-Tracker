# Copy this file to .env and fill in real values.
# .env should never be committed to git (it's in .gitignore).

# FRED API key — get a free one at
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Optional: only needed if OUTPUT_MODE in config.py includes "google_sheets"
# Path to your Google service account JSON key file.
GOOGLE_CREDS_PATH=/path/to/service_account.json
